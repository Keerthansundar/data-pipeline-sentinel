# -----------------------------------------------------------------------------
# PipelineSentinel Environment Configuration
# -----------------------------------------------------------------------------

# Application Execution Mode
DEMO_MODE=true
PR_MODE=dry_run
AGENT_ENABLED=true

# Airflow UID (50000 by default for official Airflow images)
AIRFLOW_UID=50000

# OpenAI Configuration
# Required for autonomous incident diagnosis. If blank, agent escalates by default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# GitHub Integration (Required only if PR_MODE=github)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# SMTP Alerting (Mailpit local sink for development, UI on port 8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
ALERT_EMAIL_TO=engineer@example.com
ALERT_EMAIL_FROM=pipeline-sentinel@example.com

# Ops Postgres Database (observability, profiling, incident logs)
OPS_DB_HOST=ops-postgres
OPS_DB_PORT=5432
OPS_DB_NAME=ops
OPS_DB_USER=ops_user
OPS_DB_PASSWORD=ops_password

# Airflow Metadata DB (for airflow cluster and dashboard read-only adapter)
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DASHBOARD_USER=airflow_ro
AIRFLOW_DASHBOARD_PASSWORD=airflow_ro_password

# Data Simulation Settings
ORDERS_PER_DAY=5000
